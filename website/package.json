{
    "name": "dashboards",
    "type": "module",
    "version": "0.0.1",
    "scripts": {
        "dev": "astro dev",
        "start": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro",
        "format": "eslint . --fix && prettier --write \"./**/*.{ts,tsx,json,astro,md,mdx,mjs,cjs,js}\"",
        "check": "npm run check-format && npm run check-types && npm run check-astro && npm run check-lint",
        "check-format": "prettier --check \"**/*.{ts,tsx,json,astro,md,mdx,mjs,cjs}\"",
        "check-types": "astro sync && tsc --noEmit",
        "check-astro": "astro check",
        "check-lint": "eslint .",
        "pretest": "msw init tests/mocks --no-save",
        "test": "vitest",
        "test:node": "npm test -- --project node",
        "test:headed": "npm test -- --browser.headless false",
        "test:browser": "npm test -- --project browser",
        "test:browser:headed": "npm test -- --project browser --browser.headless false",
        "e2e": "playwright test",
        "e2e:api": "playwright test --project=api",
        "e2e:chromium": "playwright test --project=chromium"
    },
    "dependencies": {
        "@astrojs/node": "^11.1.9",
        "@genspectrum/dashboard-components": "^1.19.0",
        "@tanstack/react-query": "^5.105.0",
        "astro": "^7.4.5",
        "axios": "^1.21.0",
        "better-auth": "^1.7.14",
        "cookie": "^1.1.1",
        "dayjs": "^1.11.23",
        "downshift": "^9.4.0",
        "gridjs": "^6.2.0",
        "gridjs-react": "^6.1.1",
        "katex": "^0.19.1",
        "patch-package": "^8.0.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-katex": "^3.1.0",
        "react-toastify": "^11.2.0",
        "uuid": "^14.0.3",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0",
        "yaml": "^2.9.1"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.12",
        "@astrojs/react": "^7.1.2",
        "@eslint/js": "^9.39.2",
        "@iconify-json/mdi": "^1.2.3",
        "@iconify-json/mdi-light": "^1.2.2",
        "@iconify/tailwind4": "^1.2.3",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/eslint-plugin-query": "^5.105.0",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^24.12.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/react-katex": "^3.0.4",
        "@types/topojson-specification": "^1.0.5",
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@typescript-eslint/parser": "^8.72.1",
        "@vitest/browser": "^5.1.0",
        "@vitest/browser-playwright": "^5.1.0",
        "astro-eslint-parser": "^1.4.0",
        "daisyui": "^5.7.50",
        "dotenv": "^18.0.9",
        "eslint": "^9.39.2",
        "eslint-plugin-astro": "^1.7.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "msw": "^2.14.6",
        "playwright": "^1.64.1",
        "prettier": "^3.9.10",
        "prettier-plugin-astro": "^0.14.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.0.9",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.1.0",
        "vitest-browser-react": "^2.3.0",
        "zod": "^4.6.6"
    }
}
